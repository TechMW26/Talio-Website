# GitHub Releases configuration. The repository below is the built-in default.
TALIO_RELEASE_REPO=

# Optional for public releases. Never prefix a server-side token with VITE_.
# GITHUB_RELEASE_TOKEN=github_pat_replace_with_your_token

# Optional: pin downloads to one release tag instead of the latest release.
# TALIO_RELEASE_TAG=v1.0.0
